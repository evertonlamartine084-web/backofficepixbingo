{
  "redirects": [
    {
      "source": "/widget/gamification.js",
      "destination": "https://pixbingo-gamification-backend-production.up.railway.app/widget/gamification.js",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "widget/**",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
